{
  "kind": "collectionType",
  "collectionName": "packages",
  "info": {
    "singularName": "package",
    "pluralName": "packages",
    "displayName": "Package",
    "description": "Studio Photography & Videography Pricing Packages"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "subtitle": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "badge": {
      "type": "string"
    },
    "isSignature": {
      "type": "boolean",
      "default": false
    },
    "price": {
      "type": "decimal",
      "required": true
    },
    "currency": {
      "type": "string",
      "default": "INR"
    },
    "duration": {
      "type": "string"
    },
    "coverage": {
      "type": "text"
    },
    "inclusions": {
      "type": "json"
    },
    "deliverables": {
      "type": "json"
    },
    "eventsCovered": {
      "type": "json"
    },
    "paymentTerms": {
      "type": "json"
    },
    "isActive": {
      "type": "boolean",
      "default": true
    }
  }
}
