# ==========================================
# LENS & LIGHT STUDIO (ABHISHINDE PHOTOGRAPHY)
# STRAPI BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Server
HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2,toBeModified3,toBeModified4"
API_TOKEN_SALT=tobemodified_api_salt_secret_1234
ADMIN_JWT_SECRET=tobemodified_admin_jwt_secret_5678
TRANSFER_TOKEN_SALT=tobemodified_transfer_token_salt_9101
JWT_SECRET=tobemodified_jwt_secret_1121

# PostgreSQL Database Configuration
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=lens_and_light_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_secure_postgres_password
DATABASE_SSL=false
DATABASE_SCHEMA=public

# Cloudinary Media Storage
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_YourTestKeyHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Notification Services
EMAIL_PROVIDER=sendgrid
EMAIL_API_KEY=your_sendgrid_or_smtp_key
EMAIL_FROM=bookings@lensandlightstudio.com
EMAIL_REPLY_TO=support@lensandlightstudio.com

# WhatsApp Provider Configuration (Twilio / Meta Cloud API)
WHATSAPP_API_URL=https://graph.facebook.com/v19.0/YOUR_PHONE_NUMBER_ID/messages
WHATSAPP_TOKEN=your_whatsapp_permanent_access_token
WHATSAPP_ADMIN_PHONE=+919876543210
